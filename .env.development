# Used automatically by `npm run dev`.
#
# Points at a Grogu API running on this machine. 8080 is what the container
# maps to:
#   docker run -p 8080:80 grogu-backend   -> http://localhost:8080
#   dotnet run --project Grogu_backend    -> http://localhost:5000
#
# Override just for yourself in .env.local (wins over this file, not committed).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
