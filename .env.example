# Base URL of the Grogu API. No trailing slash.
#
# You usually do not need this file: `.env.development` already points
# `npm run dev` at a local backend, and `.env.production` points builds at the
# deployed one.
#
# Copy this to .env.local only when you want to override both for yourself —
# .env.local wins over every other env file and is never committed.

# Local backend in Docker (docker run -p 8080:80)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Local backend via dotnet run
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Deployed backend
# NEXT_PUBLIC_API_BASE_URL=https://grogu-backend.onrender.com
